# --- Intervals.icu MCP server ---
# Personal API key from Intervals.icu > Settings > Developer. Never commit it.
INTERVALS_API_KEY=
# 0 means "the athlete who owns the API key".
INTERVALS_ATHLETE_ID=0
# COROS only syncs about a week of planned workouts to the watch.
INTERVALS_MAX_FUTURE_DAYS=7
# Protect the public /mcp endpoint (sent as X-API-Key or Authorization: Bearer).
MCP_API_KEY=
# Alternative for clients that cannot send headers: serves MCP at /mcp/<token>.
MCP_PATH_TOKEN=

# --- Legacy StravaGPT backend ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/callback
STRAVA_SCOPES=read,activity:read_all
DATABASE_PATH=./stravagpt.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CHATGPT_API_KEY=
PUBLIC_BASE_URL=
SYNC_ON_STARTUP=true
STARTUP_SYNC_MAX_PAGES=1
STARTUP_SYNC_PER_PAGE=30
